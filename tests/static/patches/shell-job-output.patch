+/* 全部子行程結束後才確認寫入;先消耗所有權,close 出錯也不重試。 */
+static void job_finish(struct job *j)
+{
+    if (j->left) return;
+    if (j->save_pending) {
+        long fd = j->save_fd;
+        j->save_pending = 0;
+        j->save_fd = -1;
+        long synced = sys_fsync(fd);
+        long closed = sys_close(fd);
+        if (synced == -E_INVAL) synced = 0;       /* /dev/null 等沒有持久化語意 */
+        if (synced != 0 || closed != 0) {
+            complain("write error: could not save ", j->save_path);
+            if (!j->status) j->status = 1;
+        }
+    }
+    if (j->launch_error) j->status = j->launch_error;
+}
+
+static long job_wait_all(void)
+{
+    long result = async_status;
+    async_status = 0;
+    for (struct job *j = jobs; j < jobs + MAX_JOBS; j++) {
+        if (!j->used) continue;
+        if (j->stopped) { if (!result) result = 128 + j->stopped; continue; }
+        int w = job_wait(j);
+        if (w == 2) {
+            puts_("sh: wait: could not wait for a job; it is still listed\n");
+            result = 1;
+        } else if (w) {
+            job_report_stopped(j);
+            if (!result) result = 128 + j->stopped;
+        } else {
+            if (j->status) result = j->status;    /* 成功的後一個工作不能蓋掉較早的錯誤 */
+            j->used = 0;
+        }
+    }
+    return result;
+}
+
+/* 不替仍在執行的輸出謊稱成功;不強制等可能永不結束的背景工作。 */
+static int sh_exit_status(long status)
+{
+    if (!status && async_status) status = async_status;
+    for (struct job *j = jobs; j < jobs + MAX_JOBS; j++) {
+        if (j->used && j->save_pending) {
+            puts_("sh: output is still pending; use wait before exit\n");
+            if (!status) status = 1;
+            break;
+        }
+    }
+    return (int)status;
 }
 
