  "findings": [
    {
      "id": "fd5f1a46a727d2fe3e611f78",
      "path": "kernel/proc_mem.c",
      "line": 222,
      "symbol": "commit_release_all",
      "source_line": "commit_change_locked(p, -(long)p->mem.commit);",
      "old_function_sha256": "c3855a698a15a8ec323c5c1d1aeada0bf6e0cb1613512d2e2360b17ac3eb9f2e",
      "function_sha256": "229573930c82b1e47a5270462081461d67a368d0282ac570742611ca75b0f5e2",
      "body_equal_after_documented_renames": true,
      "decision": "accepted exact unchecked call",
      "reason": "Holds pstate_lk and passes -(long)p->mem.commit. Under existing bounded-memory invariants the delta is nonpositive, release clamps to current commitment and returns 0. Current commit_change_locked body was independently compared to HEAD after documented renames."
    },
    {
      "id": "5be00e3472b51c46eee5e4de",
      "path": "kernel/proc_mem.c",
      "line": 292,
      "symbol": "sys_munmap",
      "source_line": "commit_change_locked(p, -(long)pages);",
      "old_function_sha256": "ff2dd213318fceeae57b82ee5579aacffc2f2ab582708340f61522c643b2540f",
      "function_sha256": "412447e53b6f59faf9d6ab4d44d4c10bff4678f37901fb55868df4fe35e95f45",
      "body_equal_after_documented_renames": true,
      "decision": "accepted exact unchecked call",
      "reason": "Under pstate_lk, a nonzero mapping pages count is released by negative delta before unmapping outside the lock. Only positive delta can return NOMEM. Current body equals the old body after field and lock renames; host model covers release and double-unmap rejection."
    },
    {
      "id": "81ccb02baa7772dd72d6b162",
      "path": "kernel/proc.c",
      "line": 818,
      "symbol": "sys_fork",
      "source_line": "vfs_exec_hold(c->exe);                   /* 子行程也在執行同一個程式檔 */",
      "old_function_sha256": "84b45df5f91f0dad15323a7f69aefaeb226962fb3bb152344f76730db14681c4",
      "function_sha256": "4f536a67a59304cd252685faddd14e03ddc70fde304b43dd6ae7f528990e07c5",
      "body_equal_after_documented_renames": false,
      "decision": "accepted exact unchecked call",
      "reason": "Only accepts a single-threaded parent, which retains p->exe while this syscall executes. c->exe=vfs_dup(p->exe) retains the exact same regular executable; vfs_dup cannot allocate/fail and vfs_exec_hold only rejects a non-I_FILE. The helper/order changes do not alter this exact-call premise. This does not certify all fork interleavings."
    }
  ],
